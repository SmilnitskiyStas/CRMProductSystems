<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShelfGuard.Tools.DeliveryCoverageBackfill</RootNamespace>
    <AssemblyName>ShelfGuard.Tools.DeliveryCoverageBackfill</AssemblyName>
  </PropertyGroup>

  <!--
    TASK-661 (T14): one-shot backfill tool — migrates the legacy free-text
    supplier_profiles.DeliveryRegions jsonb array into the structured
    supplier_profiles.DeliveryCoverage jsonb string (served region codes + a "Також: …" note
    for anything that could not be mapped). Idempotent (DeliveryCoverage IS NULL guard),
    defaults to a dry run; pass the apply flag to persist. Run once per environment; drop the
    DeliveryRegions column in a later migration.

    Same project layout / FrameworkReference rationale as ShelfGuard.Tools.PchilkaImport:
    references Application/Infrastructure/Domain directly so it reuses AppDbContext,
    DeliveryRegionsBackfill, DeliveryCoverageJson and the real TenantConnectionInterceptor
    exactly the way the API does, instead of hand-rolling raw SQL. Infrastructure depends on
    ASP.NET Core abstractions (IHttpContextAccessor for the interceptor), so this console app
    needs the same FrameworkReference to load them at runtime.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShelfGuard.Application\ShelfGuard.Application.csproj" />
    <ProjectReference Include="..\ShelfGuard.Infrastructure\ShelfGuard.Infrastructure.csproj" />
    <ProjectReference Include="..\ShelfGuard.Domain\ShelfGuard.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
