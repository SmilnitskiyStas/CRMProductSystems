# ShelfGuard Production Environment
# Copy to .env on the server and fill in real values

# Database (PostgreSQL on port 5434)
DATABASE_URL=Host=localhost;Port=5434;Database=shelfguard;Username=shelfguard;Password=CHANGE_ME

POSTGRES_USER=shelfguard
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=shelfguard

# JWT
JWT_SECRET=CHANGE_ME_min_32_chars_random_string
JWT_ISSUER=shelfguard
JWT_AUDIENCE=shelfguard

# Frontend — use HTTPS domain after SSL is set up (see infra/nginx/setup-ssl.sh)
# During initial deploy (before SSL): http://93.127.143.98:5100
# After SSL is live:
NEXT_PUBLIC_API_URL=https://api.agrusystems.pp.ua

# CORS — after SSL update to include HTTPS domain
Cors__Origins=https://agrusystems.pp.ua,https://www.agrusystems.pp.ua,http://localhost:3000

# Redis (shared with other projects)
REDIS_URL=redis://localhost:6379

# ПРРО fiscalization (Checkbox, ADR-012). Leave PRRO__PROVIDER empty to run without
# a fiscal provider (NoopFiscalService → receipts stay pending_fiscalization).
# Test API: https://api.checkbox.in.ua/api/v1 · Prod: https://api.checkbox.ua/api/v1
PRRO__PROVIDER=
PRRO__BASEURL=https://api.checkbox.in.ua/api/v1
PRRO__LICENSEKEY=CHANGE_ME
# Cashier auth: either PIN (preferred) or login/password
PRRO__CASHIER__PINCODE=
PRRO__CASHIER__LOGIN=
PRRO__CASHIER__PASSWORD=
