    "hero": {
      "badge": "Inventory management for grocery stores and chains",
      "titleLine": "Expiring stock shows up weeks out.",
      "titleHighlight": "Your customers never see it.",
      "description": "ShelfGuard tracks every batch's expiry date using FEFO, tells you what and how much to order, prints fiscal receipts through ПРРО, and shows the status of every store on a single screen.",
      "ctaPrimary": "Request a demo",
      "ctaSecondary": "See what it does",
      "imageAlt": "ShelfGuard dashboard: batch statuses Safe, Warning, Critical, Expired, a list of items needing attention, and quick actions"
    },
    "problem": {
      "heading": "Sound familiar?",
      "subheading": "Three reasons grocery retail loses money every single day.",
      "items": [
        {
          "title": "Write-offs eat your margin",
          "text": "Expired stock gets noticed once it's already sitting on the shelf — or once a customer returns it. Every such batch is money the store simply throws away."
        },
        {
          "title": "Expiry dates live in notebooks and spreadsheets",
          "text": "Dates get logged by hand, checked on a walk through the store \"whenever there's time.\" Human error guarantees something always slips through."
        },
        {
          "title": "Orders placed by gut feel",
          "text": "Without real sales data, orders are guesswork. The result: either surplus stock that sits around and spoils, or empty shelves and lost sales."
        }
      ]
    },
    "features": {
      "heading": "Everything a store needs, in one system",
      "subheading": "From receiving stock to a fiscal receipt. Modules turn on based on your type of business.",
      "items": [
        {
          "title": "Expiry tracking (FEFO)",
          "text": "Every batch has its own expiry date and status: normal, warning, critical, expired. The system tells you what to sell first."
        },
        {
          "title": "AI auto-ordering",
          "text": "AI analyzes sales, stock levels, and seasonality, and prepares an order suggestion every morning. All you do is review and confirm it."
        },
        {
          "title": "Fiscal POS checkout",
          "text": "A full point-of-sale system fiscalized through Checkbox: receipts, shifts, Z-reports. Every sale deducts stock instantly — batch by batch, following FEFO."
        },
        {
          "title": "Analytics and reports",
          "text": "Stock levels by zone and category, write-off losses, sales trends. Numbers for each store and for the whole chain."
        },
        {
          "title": "B2B supplier marketplace",
          "text": "A supplier catalog with prices and terms. Orders go straight to the supplier from within the system — no calls, no messaging apps."
        },
        {
          "title": "IoT temperature monitoring",
          "text": "Sensors in refrigerated display cases report temperature in real time. Any deviation triggers an instant alert, while the stock can still be saved."
        },
        {
          "title": "Mobile app with a scanner",
          "text": "Receiving, write-offs, stocktaking, and sales — all from a phone. The barcode scanner works through the camera, no extra hardware needed."
        },
        {
          "title": "Staff scheduling",
          "text": "Shift schedules for the store team live in the same system: who's working, where, and when — visible to both managers and staff in the app."
        }
      ]
    },
    "showcase": {
      "heading": "See it in action",
      "subheading": "The actual interface — dark theme, real screens, nothing extra.",
      "blocks": [
        {
          "eyebrow": "Dashboard",
          "title": "Store status at a glance",
