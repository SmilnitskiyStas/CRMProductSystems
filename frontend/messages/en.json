        },
        {
          "eyebrow": "Stock and expiry",
          "title": "The system flags the problem right away",
          "text": "Every batch shows its expiry date, days remaining, and status. Expired stock is highlighted in red — impossible to miss.",
          "points": [
            "Red \"Expired\" label with the exact day count",
            "Search by name or barcode, filter by status",
            "Healthy batches marked green \"Normal\", no extra noise"
          ],
          "image1Alt": "Batch table with expired items highlighted in red under the \"Expired\" status",
          "image2Alt": "Batches with \"Normal\" status — green markers and days remaining until expiry"
        },
        {
          "eyebrow": "Analytics",
          "title": "Numbers that show you the money",
          "text": "Batch status breakdown, stock by zone and category, write-off losses in your currency. For a single store — and for the whole chain.",
          "points": [
            "Status breakdown: how much is normal, how much has expired",
            "Breakdowns by zone and product category",
            "Write-off losses in real currency, not gut feel"
          ],
          "image1Alt": "ShelfGuard analytics: batch status distribution chart and a store summary",
          "image2Alt": "Category analytics: bar chart of stock status by product category"
        }
      ]
    },
