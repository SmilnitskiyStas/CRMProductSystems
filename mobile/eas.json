{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "autoIncrement": true,
      "android": {
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.agrusystems.pp.ua:10054/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "image": "ubuntu-24.04-jdk-17-ndk-r27b",
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.agrusystems.pp.ua:10054/api"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.agrusystems.pp.ua:10054/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
