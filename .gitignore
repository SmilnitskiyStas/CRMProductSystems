.build-check*/
.test-check*/
.obj-check*/
.refactor-obj*/
.catalog-obj*/
*.stackdump

# ── Docker / Infrastructure ──────────────────────────────────────────────────
docker-compose.override.yml

# ── Misc ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/settings.json

# Private credentials - NEVER commit
.claude/private/

# Local-only scratch working directories (not source code — e.g. local DB data dirs)
/PchilkaPosAnalytics/

# ── Cashier desktop app ──────────────────────────────────────────────────────
cashier/node_modules/
cashier/out/
cashier/dist/
cashier/release/

# User-uploaded files (floor plans, scans, item photos) must not be committed
backend/ShelfGuard.Api/wwwroot/uploads/
private-uploads/

# Generated remediation test reports are CI/local artifacts
/docs/analys/remediation/test-results/
