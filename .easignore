# EAS Build archive exclusions (eas-cli copies even git-ignored files
# into its shallow clone — a running local Gradle daemon then breaks the
# upload with EBUSY on .gradle lock files).

# Native projects are generated by prebuild on EAS (CNG) — never upload them
mobile/android
mobile/ios

# Local env files (EXPO_PUBLIC_API_URL is set via eas.json env per profile)
mobile/.env
mobile/.env.local

# Irrelevant for the mobile build — slims the tarball dramatically
backend
frontend
worker
.claude
.git
**/node_modules

# Unrelated local projects and runtime-only service sockets must never enter
# the mobile EAS archive. Windows cannot lstat an active Unix-domain socket.
PchilkaPosAnalytics
Portfolio
img
**/*.sock
