# ShelfGuard Staging Environment
# Copy to .env.staging (repo root) and fill in placeholder values.
# .env.staging is gitignored — never commit real secrets.
#
# This stack is fully self-contained (postgres/redis/mosquitto/api/web/worker
# all run in docker-compose.staging.yml on this machine) — isolated from both
# the local dev stack (docker-compose.yml, ports 5435/6380/1884/5000/3000) and
# production (docker-compose.production.yml, ports 5100/3100). Used to run the
# pre-launch audit's functional/load/security tests without touching either.

# ── Database (staging postgres container, host port 5436) ──────────────────
DATABASE_URL=Host=localhost;Port=5436;Database=shelfguard_staging;Username=shelfguard_staging;Password=CHANGE_ME
# node-pg needs a postgres:// URL for the worker (same DB, different driver format)
WORKER_DATABASE_URL=postgres://shelfguard_staging:CHANGE_ME@localhost:5436/shelfguard_staging

POSTGRES_USER=shelfguard_staging
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=shelfguard_staging

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_32_chars_random_string
JWT_ISSUER=shelfguard-staging
JWT_AUDIENCE=shelfguard-staging

# ── Frontend / CORS ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5101
Cors__Origins=http://localhost:3101
# TASK-456: base URL the backend embeds in forgot-password reset links.
Frontend__BaseUrl=http://localhost:3101

# ── Redis (staging container, host port 6381) ───────────────────────────
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6381
WORKER_REDIS_URL=redis://localhost:6381

# ── Mosquitto (staging container, host port 1885) ───────────────────────
WORKER_MQTT_URL=mqtt://localhost:1885

# ── Worker → API auth (used by worker jobs that call back into the API) ──
API_BASE_URL=http://localhost:5101
WORKER_API_EMAIL=
WORKER_API_PASSWORD=

# ── Claude API (optional — leave blank to disable AI features in staging) ─
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── ПРРО fiscalization (optional — leave PRRO__PROVIDER empty to disable) ─
PRRO__PROVIDER=
PRRO__BASEURL=https://api.checkbox.in.ua/api/v1
PRRO__LICENSEKEY=
PRRO__CASHIER__PINCODE=
PRRO__CASHIER__LOGIN=
PRRO__CASHIER__PASSWORD=

# ── Telegram / Email (optional) ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
FROM_EMAIL=noreply@shelfguard.app

# ── Seeding (KI-006 fix) ─────────────────────────────────────────────────
# Staging auto-seeds test data (DbSeeder) on every fresh boot. This is NOT
# real client data. Never set this to true in .env.production.
SEED_ON_START=true
